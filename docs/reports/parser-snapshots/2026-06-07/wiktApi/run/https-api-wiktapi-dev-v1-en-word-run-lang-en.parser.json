        "senses": [
          {
            "glosses": [
              "To move swiftly.",
              "To move forward quickly upon two feet by alternately making a short jump off either foot."
            ],
            "raw_glosses": [
              "To move swiftly.",
              "(intransitive) To move forward quickly upon two feet by alternately making a short jump off either foot."
            ],
            "examples": [
              {
                "text": "Run, and you might still catch the train!",
                "bold_text_offsets": [
                  [
                    0,
                    3
                  ]
                ],
                "type": "example"
              },
              {
                "text": "Through the open front door ran Jessamy, down the steps to where Kitto was sitting at the bottom with the pram beside him.",
                "ref": "1967, Barbara Sleigh, Jessamy, Sevenoaks, Kent: Bloomsbury, published 1993, →ISBN, page 122:",
                "type": "quotation",
                "bold_text_offsets": [
                  [
                    28,
                    31
                  ]
                ]
              }
            ],
            "tags": [
              "intransitive"
            ]
          },
          {
            "glosses": [
              "To move swiftly.",
              "To go at a fast pace; to move quickly."
            ],
            "raw_glosses": [
              "To move swiftly.",
              "(intransitive) To go at a fast pace; to move quickly."
            ],
            "examples": [
              {
                "text": "I have been running all over the building looking for him.",
                "bold_text_offsets": [
                  [
                    12,
                    19
                  ]
                ],
                "type": "example"
              },
              {
                "text": "Sorry, I've got to run; my house is on fire!",
                "bold_text_offsets": [
                  [
                    19,
                    22
                  ]
                ],
                "type": "example"
              },
              {
                "text": "Once I ran to you (I ran) / Now I run from you / This tainted love you've given / I give you all a boy could give you",
                "ref": "1965, Ed Cobb, “Tainted Love”, in Non-Stop Erotic Cabaret, performed by Soft Cell, published 1981:",
                "type": "quotation",
                "bold_text_offsets": [
                  [
                    7,
                    10
                  ],
                  [
                    21,
                    24
                  ],
                  [
                    34,
                    37
                  ]
                ]
              }
            ],
            "tags": [
              "intransitive"
            ]
          },
          {
            "glosses": [
              "To move swiftly.",
              "To cover (a course or a distance) by running."
            ],
            "raw_glosses": [
              "To move swiftly.",
              "(transitive) To cover (a course or a distance) by running."
            ],
            "examples": [
              {
                "text": "I can run a mile, but I can't run the cross-country course.",
                "bold_text_offsets": [
                  [
                    6,
                    9
                  ],
                  [
                    30,
                    33
                  ]
                ],
                "type": "example"
              }
            ],
            "tags": [
              "transitive"
            ]
          },
          {
            "glosses": [
              "To move swiftly.",
              "To complete a running course or event in (a given time)."
            ],
            "raw_glosses": [
              "To move swiftly.",
              "(transitive) To complete a running course or event in (a given time)."
            ],
            "examples": [
              {
                "text": "I was hoping to make the team, but I didn't run the qualifying time.",
