        "senses": [
          {
            "glosses": [
              "To perceive the truth or factuality of; to be certain of; to be certain that."
            ],
            "raw_glosses": [
              "(transitive) To perceive the truth or factuality of; to be certain of; to be certain that."
            ],
            "examples": [
              {
                "text": "Question things. I have the most fun when I'm writing questioning things that people do not question- the assumptions that everybody knows are true.",
                "ref": "1985 April 17, Frank Herbert, 15:46 from the start, in Frank Herbert speaking at UCLA 4/17/1985, UCLACommStudies, archived from the original on 10 Feb 2017:",
                "type": "quotation",
                "bold_text_offsets": [
                  [
                    133,
                    138
                  ]
                ]
              },
              {
                "text": "'[…] I know whether a boy is telling me the truth or not.'\n'Thank you, sir.'\nDid he hell. They never bloody did.",
                "ref": "1991 September, Stephen Fry, chapter 1, in The Liar, London: Heinemann, →ISBN, section II, page 24:",
                "type": "quotation",
                "bold_text_offsets": [
                  [
                    7,
                    11
                  ]
                ]
              },
              {
                "text": "I know that I’m right and you’re wrong.",
                "bold_text_offsets": [
                  [
                    2,
                    6
                  ]
                ],
                "type": "example"
              }
            ],
            "tags": [
              "transitive"
            ]
          },
          {
            "glosses": [
              "To be or become aware or cognizant."
            ],
            "raw_glosses": [
              "(intransitive) To be or become aware or cognizant."
            ],
            "examples": [
              {
                "text": "Did you know Michelle and Jack were getting divorced? ― Yes, I knew.",
                "bold_text_offsets": [
                  [
                    63,
                    67
                  ]
                ],
                "type": "example"
              },
              {
                "text": "Malware's sometimes been known to sit dormant for a long time.",
                "bold_text_offsets": [
                  [
                    25,
                    30
                  ]
                ],
                "type": "example"
              },
              {
                "text": "‘A Gentleman!’ quoth the Squire, ‘who the Devil can he be? Do, Doctor, go down and ſee who ’tis. Mr. Blifil can hardly be come to town yet.—Go down, do, and know what his Buſineſs is.[’]",
                "ref": "1749, Henry Fielding, “A whimsical Adventure which befel the Squire, with the distressed Situation of Sophia”, in The History of Tom Jones, a Foundling, volume VI, London: A[ndrew] Millar, […], →OCLC, book XVI, page 7:",
                "type": "quotation",
                "bold_text_offsets": [
                  [
                    157,
                    161
                  ]
                ]
              }
            ],
            "tags": [
              "intransitive"
            ]
          },
          {
            "glosses": [
              "To be aware of; to be cognizant of."
            ],
            "raw_glosses": [
              "(transitive) To be aware of; to be cognizant of."
            ],
            "examples": [
              {
                "text": "Did you know Michelle and Jack were getting divorced? ― Yes, I knew.",
                "bold_text_offsets": [
                  [
                    8,
                    12
                  ]
                ],
                "type": "example"
              },
              {
                "text": "She knows where I live.",
                "bold_text_offsets": [
                  [
                    4,
                    9
                  ]
                ],
                "type": "example"
              },
              {
                "text": "I knew he was upset, but I didn't understand why.",
                "bold_text_offsets": [
                  [
                    2,
                    6
                  ]
                ],
                "type": "example"
              }
            ],
            "tags": [
              "transitive"
            ]
          },
          {
            "glosses": [
              "To be acquainted (with another person)."
            ],
            "raw_glosses": [
              "(intransitive, obsolete) To be acquainted (with another person)."
            ],
            "examples": [
