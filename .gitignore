.env
.env.*
!.env.example

# Vite / TypeScript caches
node_modules/.vite/
.eslintcache
*.tsbuildinfo
.turbo/

# OS / IDE clutter beyond the explicit allow-list above
*.swp
*.bak
.history/

# Test coverage & output
coverage/
.audit/

# Throwaway test/debug scripts at root
test.js
test.cjs
test.mjs

# Throwaway simulation / audit / debug scratch files (prefixed .tmp-)
.tmp-*

# Page templates used for local debugging (contain personal HTML snapshots)
*_page_template.html

# Chrome extension packaging artifacts
*.crx
*.pem
*.xpi
web-ext-artifacts/

# Design mock reference (local only, not part of the source)
mock/

# Avoid mixing package managers — the project is on pnpm (pnpm-lock.yaml).
package-lock.json
yarn.lock

# Postman tool artifacts (empty scaffolding, not project files)
postman/
.postman/

# Regenerable runtime audit JSONs (evidence snapshots; fixtures/ ARE tracked for tests)
docs/reports/runtime/*.json

# Private agent workspace prompt (not project code)
AGENTS.md
