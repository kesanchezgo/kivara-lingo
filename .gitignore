# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependency directories
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Kiro workspace settings (personal MCP configs, etc.)
.kiro/settings/

# Env files
.env
.env.*
!.env.example

# Vite / TypeScript caches
node_modules/.vite/
.eslintcache
*.tsbuildinfo
.turbo/

# OS / IDE clutter beyond the explicit allow-list above
*.swp
*.bak
.history/

# Test coverage & output
coverage/
.audit/
.audit-bak/

# Local pack downloads + seeded Chromium profiles (regenerable via scripts/seed-yomitan-packs.mjs)
.audit/packs/
.audit/mv3-yomitan-profile/
.audit/mv3-corpus-profile/
.audit/mv3-image-profile/
.audit/mv3-profile/
.audit/mv3-quality-fix-profile/

# Split-audit scratch files (HOT/COLD subsets regenerable from source assets)
.audit/en-idioms-*.json
.audit/en-idioms-full-backup.json

# Playwright E2E output (regenerable run artifacts, traces, screenshots)
test-results/
playwright-report/
.playwright/

# Throwaway test/debug scripts at root
test.js
test.cjs
test.mjs

# Throwaway simulation / audit / debug scratch files (prefixed .tmp-)
.tmp-*

# Page templates used for local debugging (contain personal HTML snapshots)
*_page_template.html

# Chrome extension packaging artifacts
*.crx
*.pem
*.xpi
web-ext-artifacts/

# Design mock reference (local only, not part of the source)
mock/

# Avoid mixing package managers — the project is on pnpm (pnpm-lock.yaml).
package-lock.json
yarn.lock

# Postman tool artifacts (empty scaffolding, not project files)
postman/
.postman/

# Regenerable runtime audit JSONs (evidence snapshots; fixtures/ ARE tracked for tests)
docs/reports/runtime/*.json

# Private agent workspace prompt (not project code)
AGENTS.md
CLAUDE.md

# Exported browser cookies / session dumps — NEVER commit (live auth tokens).
# These are local capture-debugging aids, not project data.
cookies_*.txt
*.cookies.txt
*_cookies.txt
