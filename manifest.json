{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "0.3.0",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/kesanchezgo/kivara-lingo",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabCapture",
    "offscreen",
    "alarms",
    "tts",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.bamgrid.com/*",
    "*://*.cloudfront.net/*",
    "*://*.disney-plus.net/*",
    "*://*.disneyplus.com/*",
    "*://*.hbomax.com/*",
    "*://*.max.com/*",
    "*://*.media-amazon.com/*",
    "*://*.netflix.com/*",
    "*://*.nflxvideo.net/*",
    "*://*.primevideo.com/*",
    "*://*.youtube.com/*",
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1/*",
    "http://[::1]:8765/*",
    "http://[::1]/*",
    "http://localhost:8765/*",
    "http://localhost/*",
    "https://*.youtube.com/embed/*",
    "*://*.amazon.com/gp/video/*",
    "*://*.amazon.co.uk/gp/video/*",
    "*://*.amazon.de/gp/video/*",
    "*://*.amazon.es/gp/video/*",
    "*://*.amazon.fr/gp/video/*",
    "*://*.amazon.it/gp/video/*",
    "*://*.amazon.co.jp/gp/video/*",
    "*://*.amazon.ca/gp/video/*",
    "*://*.amazon.com.mx/gp/video/*",
    "*://*.amazon.com.br/gp/video/*",
    "*://*.amazon.in/gp/video/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hbomax.com/*",
        "*://*.max.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.co.uk/gp/video/*",
        "*://*.amazon.de/gp/video/*",
        "*://*.amazon.es/gp/video/*",
        "*://*.amazon.fr/gp/video/*",
        "*://*.amazon.it/gp/video/*",
        "*://*.amazon.co.jp/gp/video/*",
        "*://*.amazon.ca/gp/video/*",
        "*://*.amazon.com.mx/gp/video/*",
        "*://*.amazon.com.br/gp/video/*",
        "*://*.amazon.in/gp/video/*"
      ],
      "js": [
        "src/content/index.tsx"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hbomax.com/*",
        "*://*.max.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.co.uk/gp/video/*",
        "*://*.amazon.de/gp/video/*",
        "*://*.amazon.es/gp/video/*",
        "*://*.amazon.fr/gp/video/*",
        "*://*.amazon.it/gp/video/*",
        "*://*.amazon.co.jp/gp/video/*",
        "*://*.amazon.ca/gp/video/*",
        "*://*.amazon.com.mx/gp/video/*",
        "*://*.amazon.com.br/gp/video/*",
        "*://*.amazon.in/gp/video/*"
      ],
      "js": [
        "src/content/platform-adapters/main-world-interceptor.ts"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/dictionaries/*",
        "src/assets/fonts/*",
        "src/assets/frequency/*"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hbomax.com/*",
        "*://*.max.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.es/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.in/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Kivara Lingo",
    "default_icon": {
      "16": "src/assets/icons/icon-16.png",
      "32": "src/assets/icons/icon-32.png",
      "48": "src/assets/icons/icon-48.png",
      "128": "src/assets/icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "save_word": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "__MSG_commandSaveWord__"
    },
    "save_word_alt": {
      "description": "__MSG_commandSaveWordAlt__"
    },
    "toggle_subtitles": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "__MSG_commandToggleSubtitles__"
    },
    "repeat_cue": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "__MSG_commandRepeatCue__"
    },
    "recapture_frame": {
      "description": "__MSG_commandRecaptureFrame__"
    },
    "toggle_panel": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K"
      },
      "description": "__MSG_commandTogglePanel__"
    }
  },
  "icons": {
    "16": "src/assets/icons/icon-16.png",
    "32": "src/assets/icons/icon-32.png",
    "48": "src/assets/icons/icon-48.png",
    "128": "src/assets/icons/icon-128.png"
  },
  "optional_host_permissions": [
    "https://*.bing.net/*",
    "https://*.dictionary.cambridge.org/*",
    "https://*.forvo.com/*",
    "https://*.github.io/*",
    "https://*.libretranslate.com/*",
    "https://*.linguee.com/*",
    "https://*.ozdic.com/*",
    "https://*.pixabay.com/*",
    "https://*.r2.dev/*",
    "https://*.tatoeba.org/*",
    "https://*.unsplash.com/*",
    "https://*.wiktionary.org/*",
    "https://api-free.deepl.com/*",
    "https://api.anthropic.com/*",
    "https://api.datamuse.com/*",
    "https://api.deepl.com/*",
    "https://api.deepseek.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.elevenlabs.io/*",
    "https://api.groq.com/*",
    "https://api.mistral.ai/*",
    "https://api.mymemory.translated.net/*",
    "https://api.openai.com/*",
    "https://api.openverse.engineering/*",
    "https://api.openverse.org/*",
    "https://api.tatoeba.org/*",
    "https://api.together.xyz/*",
    "https://api.unsplash.com/*",
    "https://api.wiktapi.dev/*",
    "https://api.x.ai/*",
    "https://audio.dictionary.com/*",
    "https://cdn.pixabay.com/*",
    "https://codeload.github.com/*",
    "https://commons.lingualibre.org/*",
    "https://commons.wikimedia.org/*",
    "https://context.reverso.net/*",
    "https://dictionary.cambridge.org/*",
    "https://dictionary.com/*",
    "https://duckduckgo.com/*",
    "https://en.bab.la/*",
    "https://en.pons.com/*",
    "https://en.wiktionary.org/*",
    "https://enes.dict.cc/*",
    "https://forvo.com/*",
    "https://freedictionaryapi.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://github.com/*",
    "https://images.unsplash.com/*",
    "https://libretranslate.com/*",
    "https://lingualibre.org/*",
    "https://lingva.lunar.icu/*",
    "https://lingva.ml/*",
    "https://lingva.pussthecat.org/*",
    "https://media.merriam-webster.com/*",
    "https://moby-thesaurus.org/*",
    "https://openrouter.ai/*",
    "https://ozdic.com/*",
    "https://pixabay.com/*",
    "https://raw.githubusercontent.com/*",
    "https://theidioms.com/*",
    "https://thesaurus.com/*",
    "https://translate.google.com/*",
    "https://translate.plausibility.cloud/*",
    "https://translation.googleapis.com/*",
    "https://unsplash.com/*",
    "https://upload.wikimedia.org/*",
    "https://wordhippo.com/*",
    "https://www.bing.com/*",
    "https://www.britannica.com/*",
    "https://www.dictionary.com/*",
    "https://www.etymonline.com/*",
