{
  "manifest_version": 3,
  "name": "Kivara Lingo",
  "version": "0.2.0",
  "description": "Learn languages while watching your favorite shows.",
  "homepage_url": "https://github.com/kesanchezgo/kivara-lingo",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "tabCapture",
    "offscreen",
    "alarms",
    "tts",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.bamgrid.com/*",
    "*://*.cloudfront.net/*",
    "*://*.disney-plus.net/*",
    "*://*.disneyplus.com/*",
    "*://*.hbomax.com/*",
    "*://*.max.com/*",
    "*://*.media-amazon.com/*",
    "*://*.netflix.com/*",
    "*://*.nflxvideo.net/*",
    "*://*.primevideo.com/*",
    "*://*.youtube.com/*",
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1/*",
    "http://localhost:8765/*",
    "http://localhost/*",
    "https://*.youtube.com/embed/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hbomax.com/*",
        "*://*.max.com/*",
        "*://*.primevideo.com/*"
      ],
      "js": [
        "src/content/index.tsx"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hbomax.com/*",
        "*://*.max.com/*",
        "*://*.primevideo.com/*"
      ],
      "js": [
        "src/content/platform-adapters/main-world-interceptor.ts"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/dictionaries/*",
        "src/onboarding/*"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hbomax.com/*",
        "*://*.max.com/*",
        "*://*.primevideo.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Kivara Lingo",
    "default_icon": {
      "16": "src/assets/icons/icon-16.png",
      "32": "src/assets/icons/icon-32.png",
      "48": "src/assets/icons/icon-48.png",
      "128": "src/assets/icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "save_word": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Guardar palabra / selección actual en Anki"
    },
    "save_word_alt": {
      "description": "Atajo alternativo (sin colisión con \"Guardar página\"). Asígnalo en chrome://extensions/shortcuts si prefieres otro atajo."
    },
    "toggle_subtitles": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Toggle subtitles visibility"
    },
    "repeat_cue": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "Repeat current subtitle phrase"
    },
    "recapture_frame": {
      "description": "Re-capturar frame y actualizar la última tarjeta Anki (por defecto Alt+V, configurable en la página)"
    },
    "toggle_panel": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K"
      },
      "description": "Open / close Kivara panel"
    }
  },
  "icons": {
    "16": "src/assets/icons/icon-16.png",
    "32": "src/assets/icons/icon-32.png",
    "48": "src/assets/icons/icon-48.png",
    "128": "src/assets/icons/icon-128.png"
  },
  "optional_host_permissions": [
    "https://*.bing.net/*",
    "https://*.dictionary.cambridge.org/*",
    "https://*.forvo.com/*",
    "https://*.github.io/*",
    "https://*.libretranslate.com/*",
    "https://*.linguee.com/*",
    "https://*.ozdic.com/*",
    "https://*.pixabay.com/*",
    "https://*.r2.dev/*",
    "https://*.tatoeba.org/*",
    "https://*.unsplash.com/*",
    "https://*.wiktionary.org/*",
    "https://api-free.deepl.com/*",
    "https://api.anthropic.com/*",
    "https://api.datamuse.com/*",
    "https://api.deepl.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.elevenlabs.io/*",
    "https://api.mymemory.translated.net/*",
    "https://api.openai.com/*",
    "https://api.openverse.engineering/*",
    "https://api.openverse.org/*",
    "https://api.tatoeba.org/*",
    "https://api.unsplash.com/*",
    "https://api.wiktapi.dev/*",
    "https://audio.dictionary.com/*",
    "https://audio00.forvo.com/*",
    "https://audio12.forvo.com/*",
    "https://cdn.pixabay.com/*",
    "https://codeload.github.com/*",
    "https://commons.lingualibre.org/*",
    "https://commons.wikimedia.org/*",
    "https://context.reverso.net/*",
    "https://dictionary.cambridge.org/*",
    "https://dictionary.com/*",
    "https://duckduckgo.com/*",
    "https://en.bab.la/*",
    "https://en.pons.com/*",
    "https://en.wiktionary.org/*",
    "https://enes.dict.cc/*",
    "https://forvo.com/*",
    "https://freedictionaryapi.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://github.com/*",
    "https://images.unsplash.com/*",
    "https://libretranslate.com/*",
    "https://lingualibre.org/*",
    "https://lingva.lunar.icu/*",
    "https://lingva.pussthecat.org/*",
    "https://lingva.thedaviddelta.com/*",
    "https://media.merriam-webster.com/*",
    "https://moby-thesaurus.org/*",
    "https://ozdic.com/*",
    "https://pixabay.com/*",
    "https://raw.githubusercontent.com/*",
    "https://theidioms.com/*",
    "https://thesaurus.com/*",
    "https://translate.google.com/*",
    "https://translate.plausibility.cloud/*",
    "https://translation.googleapis.com/*",
    "https://unsplash.com/*",
    "https://upload.wikimedia.org/*",
    "https://wordhippo.com/*",
    "https://www.bing.com/*",
    "https://www.britannica.com/*",
    "https://www.dictionary.com/*",
    "https://www.etymonline.com/*",
    "https://www.google.com/*",
    "https://www.ldoceonline.com/*",
    "https://www.linguee.com/*",
    "https://www.merriam-webster.com/*",
    "https://www.online-translator.com/*",
    "https://www.oxfordlearnersdictionaries.com/*",
    "https://www.spanishdict.com/*",
    "https://www.theidioms.com/*",
    "https://www.thesaurus.com/*",
    "https://www.wikidata.org/*",
    "https://www.wordhippo.com/*",
    "https://www.wordreference.com/*",
    "https://youglish.com/*"
  ]
}
